// WP-ITM-03 example: comments, identity maps, scoped contexts, and package contexts.
%metadata
{
  title: WP-ITM-03 scoped context example
  defaultNamespace: local
}

%package bpmn_context_profile
{
  defaultContext: package_process
  activation:
    - bpmn_context_profile.contexts
}

%namespace bpmn https://www.omg.org/spec/BPMN/20100524/MODEL

%entitytype bpmn::Process
%entitytype bpmn::Task
{
  extends:
    - bpmn::Process
}
%relationshiptype bpmn::sequenceFlow
{
  sourceTypes:
    - bpmn::Process
  targetTypes:
    - bpmn::Process
}

%idmap
{
  order_process: enterprise::order-process-001
}

%context package_process
{
  defaults:
    rootType: bpmn::Process
    childType: bpmn::Task
    relationshipType: bpmn::sequenceFlow
}

%begin bpmn_context_profile
&order_process Order process
  // This child should infer bpmn::Task from the active context.
  &receive Receive order @validate
  &validate Validate order
%end bpmn_context_profile

&after_scope Plain item outside the scoped context
