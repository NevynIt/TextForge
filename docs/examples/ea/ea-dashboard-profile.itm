%relationshiptype ead::security_domain
{
  description: Django foreign key to architecture.securitydomain.
  sourceTypes:
    - ead::Record
  targetTypes:
    - ead::SecurityDomain
  jsonField: security_domain
  cardinality: optional-one
}

