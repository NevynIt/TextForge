%metadata
{
  title: TextForge EA Dashboard ITM Profile
  version: 0.1.0
  status: draft
  defaultNamespace: ead
  profile: itm.ea.dashboard
  sourceFormat: Django fixture JSON
  description: Reusable ITM package for the EA Dashboard architecture JSON exports from C:/Stuff/ea-dashboard.
}

%package ea_dashboard_profile
{
  version: 0.1.0
  namespace: ead
  profileKind: enterprise-architecture-json-profile
  sourceFormat: Django fixture JSON
  sourceApplication: ea-dashboard
  sourceModels:
    - architecture.securitydomain
    - architecture.domain
    - architecture.capability
    - architecture.system
    - architecture.service
    - architecture.dataentity
    - architecture.datacenter
    - architecture.rack
    - architecture.server
    - architecture.cloudresource
    - architecture.database
    - architecture.project
    - architecture.strategicgoal
    - architecture.valuestream
    - architecture.businessunit
    - architecture.businessprocess
  activation:
    - ea_dashboard_profile.types
    - ea_dashboard_profile.relationships
    - ea_dashboard_profile.rules
    - ea_dashboard_profile.styles
    - ea_dashboard_profile.viewpoints
}

%namespace ead https://example.org/textforge/ea-dashboard
%namespace itm https://example.org/itm
%namespace prov https://www.w3.org/ns/prov
%namespace layout https://example.org/itm/layout

%require itm.core ^0.1.0
%require itm.validation ^0.1.0
%require itm.graph-model ^0.1.0
%require itm.viewpoint ^0.1.0
%require itm.roundtrip.meta ^0.1.0
%require ead.translator.lua ^0.1.0

%entitytype ead::Record
{
  abstract: true
  description: Base type for one Django fixture record from the EA Dashboard JSON export.
  requiredAttributes:
    - sourceModel
    - sourcePk
  recommendedAttributes:
    - sourceOrder
    - name
    - description
    - security_domain
}

%entitytype ead::SecurityDomain
{
  extends:
    - ead::Record
  sourceModel: architecture.securitydomain
  sourceFields:
    - name
    - abbreviation
    - level
    - color
  requiredAttributes:
    - name
    - abbreviation
    - level
    - color
}

%entitytype ead::Domain
{
  extends:
    - ead::Record
  sourceModel: architecture.domain
  sourceFields:
    - name
    - description
    - security_domain
}

%entitytype ead::Capability
{
  extends:
    - ead::Record
  sourceModel: architecture.capability
  sourceFields:
    - domain
    - name
    - description
    - security_domain
}

%entitytype ead::System
{
  extends:
    - ead::Record
  sourceModel: architecture.system
  sourceFields:
