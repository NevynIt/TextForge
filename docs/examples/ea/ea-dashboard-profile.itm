%rule ead_records_preserve_source_identity
{
  select: "[ead::Record]"
  pipeline:
    - requireAttribute: sourceModel
    - requireAttribute: sourcePk
  severity: error
  message: "EA Dashboard records must keep sourceModel and sourcePk for JSON round-trip export."
}

%rule ead_relationships_preserve_json_field
{
  select: "ANY(@ead::security_domain:*, @ead::domain:*, @ead::capabilities:*, @ead::system:*, @ead::consumed_by:*, @ead::datacenter:*, @ead::systems:*, @ead::rack:*, @ead::cloud_resource:*, @ead::dependencies:*, @ead::domains:*, @ead::services:*, @ead::servers:*, @ead::cloud_resources:*, @ead::projects:*, @ead::strategic_goals:*, @ead::value_streams:*, @ead::value_stream:*, @ead::business_unit:*)"
  pipeline:
    - requireSourceId
    - requireTargetResolvedOrRoundTripId
  severity: warning
  message: "EA Dashboard relationship targets should resolve or keep deterministic round-trip ids."
}

%style [ead::SecurityDomain]
{
  shape: tag
  fill: "#f8fafc"
  stroke: "#64748b"
}

%style [ead::Domain]
{
  shape: rounded-rectangle
  fill: "#e0f2fe"
  stroke: "#0284c7"
}

%style [ead::Capability]
{
  shape: rounded-rectangle
  fill: "#fef3c7"
  stroke: "#d97706"
}

%style [ead::System]
{
  shape: rectangle
  fill: "#dcfce7"
  stroke: "#16a34a"
}

%style [ead::Service]
{
  shape: rectangle
  fill: "#f0f9ff"
  stroke: "#2563eb"
}

%style [ead::Datacenter]
{
  shape: cylinder
  fill: "#ede9fe"
  stroke: "#7c3aed"
}

%style [ead::Rack]
{
  shape: rectangle
  fill: "#f1f5f9"
  stroke: "#475569"
}

%style [ead::Server]
{
  shape: rectangle
  fill: "#e2e8f0"
  stroke: "#334155"
}

%style [ead::Project]
{
  shape: rounded-rectangle
  fill: "#fae8ff"
  stroke: "#c026d3"
}

%style @ead::security_domain:*
{
  stroke: "#64748b"
  stroke-dasharray: "3 3"
}

%viewpoint ead_global_dashboard
{
  description: Mirrors the EA Dashboard global systems map with network, capability, and dependency perspectives.
  parameters:
    timelineYear:
      type: integer
      default: 2026
      minimum: 2012
      maximum: 2042
    detailLevel:
      type: integer
      default: 2
      minimum: 1
      maximum: 3
    viewpoint:
      enum:
        - network
        - capability
        - dependency
      default: network
  pipeline:
    - select: "ANY([ead::System], [ead::Service], [ead::Database], [ead::CloudResource], [ead::Datacenter], [ead::Project])"
    - includeEdges: "ANY(@ead::capabilities:*, @ead::system:*, @ead::consumed_by:*, @ead::datacenter:*, @ead::systems:*, @ead::cloud_resource:*, @ead::dependencies:*, @ead::services:*, @ead::servers:*, @ead::cloud_resources:*)"
    - transform: graph.model
    - layout: dagre
    - render: graph.viewer
}

%viewpoint ead_business_dashboard
{
  description: Mirrors the business architecture path from strategic goals to value streams, processes, and systems.
  pipeline:
    - select: "ANY([ead::StrategicGoal], [ead::ValueStream], [ead::BusinessUnit], [ead::BusinessProcess], [ead::System], [ead::Capability], [ead::Domain])"
    - includeEdges: "ANY(@ead::strategic_goals:*, @ead::value_streams:*, @ead::value_stream:*, @ead::business_unit:*, @ead::systems:*, @ead::capabilities:*, @ead::domain:*)"
    - transform: graph.model
    - layout: dagre
    - render: graph.viewer
}

%viewpoint ead_infrastructure_dashboard
{
  description: Mirrors the datacenter/rack/server physical placement and hosting model.
  pipeline:
    - select: "ANY([ead::Datacenter], [ead::Rack], [ead::Server], [ead::System], [ead::Database], [ead::CloudResource])"
    - includeEdges: "ANY(@ead::datacenter:*, @ead::rack:*, @ead::systems:*, @ead::system:*, @ead::cloud_resource:*)"
    - transform: graph.model
    - layout: dagre
    - render: graph.viewer
}

%view ea_dashboard_global
{
  viewpoint: ead_global_dashboard
  title: EA Dashboard global map
  parameters:
    timelineYear: 2026
    detailLevel: 2
    viewpoint: network
}

%view ea_dashboard_business
{
  viewpoint: ead_business_dashboard
  title: EA Dashboard business architecture
}

%view ea_dashboard_infrastructure
{
  viewpoint: ead_infrastructure_dashboard
  title: EA Dashboard infrastructure architecture
}
