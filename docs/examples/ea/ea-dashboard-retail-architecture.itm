%viewpoint retail_portfolio_delivery
{
  description: Connects the retail change portfolio to the domains, capabilities, systems, services, servers, and cloud resources it is changing.
  pipeline:
    - select: "ANY([ead::Project], [ead::Domain], [ead::Capability], [ead::System], [ead::Service], [ead::Server], [ead::CloudResource])"
    - includeEdges: "ANY(@ead::dependencies:*, @ead::domains:*, @ead::capabilities:*, @ead::systems:*, @ead::services:*, @ead::servers:*, @ead::cloud_resources:*)"
    - transform: graph.model
    - layout: dagre
    - render: graph.viewer
}

%viewpoint retail_data_trust_landscape
{
  description: Focuses the retail data, identity, payments, fraud, and analytics control plane across systems, services, data entities, databases, and cloud resources.
  pipeline:
    - select: "ANY([ead::SecurityDomain], [ead::System], [ead::Service], [ead::DataEntity], [ead::Database], [ead::CloudResource])"
    - includeEdges: "ANY(@ead::security_domain:*, @ead::system:*, @ead::consumed_by:*, @ead::systems:*, @ead::cloud_resource:*)"
    - transform: graph.model
    - layout: dagre
    - render: graph.viewer
}

%viewpoint retail_execution_dashboard
{
  description: Traces strategy through value streams, business units, operating processes, delivery projects, and the systems they rely on.
  pipeline:
    - select: "ANY([ead::StrategicGoal], [ead::ValueStream], [ead::BusinessUnit], [ead::BusinessProcess], [ead::Project], [ead::System])"
    - includeEdges: "ANY(@ead::strategic_goals:*, @ead::value_streams:*, @ead::value_stream:*, @ead::business_unit:*, @ead::projects:*, @ead::systems:*)"
    - transform: graph.model
    - layout: dagre
    - render: graph.viewer
}

